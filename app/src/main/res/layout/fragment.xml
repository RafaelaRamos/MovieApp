<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.MovieFragment">


    <EditText
        android:id="@+id/nameEt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Name"
        android:inputType="text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <EditText
        android:id="@+id/studioEt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Studio"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/nameEt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <EditText
        android:id="@+id/minutesEt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Minutes"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/studioEt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <EditText
        android:id="@+id/scoreEt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Score"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/minutesEt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <EditText
        android:id="@+id/yearEt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/year"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/scoreEt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Spinner
        android:id="@+id/genreEt"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:spinnerMode="dropdown"
        app:layout_constraintTop_toBottomOf="@id/yearEt"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/spiner_border"/>

    <CheckBox
        android:id="@+id/watchedEt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/watched"
        app:layout_constraintTop_toBottomOf="@id/genreEt"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/saveBt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/save_movie"
        app:layout_constraintTop_toBottomOf="@id/watchedEt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
